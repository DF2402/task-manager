{
  "name": "pixiv-backend",
  "version": "1.0.0",
  "description": "Pixiv project backend with TypeScript and SQLite",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "dev:backend": "ts-node src/app.ts",
    "init-db": "ts-node src/scripts/initDatabase.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "setup": "npm run init-db && npm run seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "typescript",
    "sqlite",
    "backend",
    "pixiv"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@types/sqlite3": "^3.1.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
